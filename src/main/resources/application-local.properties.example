# Copy this file to application-local.properties and keep the copy uncommitted.
DB_URL=jdbc:postgresql://localhost:5433/korea_point
DB_USERNAME=postgres
DB_PASSWORD=korea_point_local

# Social login credentials. Fill these in application-local.properties, not here.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Gmail SMTP app password for email verification.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
RESERVATION_MAIL_USERNAME=
RESERVATION_MAIL_APP_PASSWORD=

# PortOne V1 / TossPayments test channel only (iamporttest_3)
portone.enabled=false
portone.test-channel-confirmed=false
portone.user-code=
portone.channel-key=
# Set these only in your gitignored application-local.properties or use environment variables.
